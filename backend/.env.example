# PostgreSQL Connection URL
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/uptime_db?schema=public"

# Backend Server Port
PORT=5000

# JWT Authentication Secret
JWT_SECRET="replace_with_a_secure_random_secret_key"

# Environment
NODE_ENV="development"

# Frontend Origin for CORS (Optional)
FRONTEND_URL="http://localhost:3000"
