datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum HttpMethod {
  GET
  POST
  HEAD
}

enum AlertChannelType {
  EMAIL
  TELEGRAM
  SLACK
  DISCORD
  WEBHOOK
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String         @map("password_hash")
  name          String
  timezone      String         @default("UTC")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  monitors      Monitor[]
  alertChannels AlertChannel[]

  @@map("users")
}

model Monitor {
  id               String                 @id @default(uuid())
  userId           String                 @map("user_id")
  name             String
  url              String
  method           HttpMethod             @default(GET)
  intervalSec      Int                    @default(300) @map("interval_sec") // 60, 300, 900
  timeoutSec       Int                    @default(10) @map("timeout_sec")   // 5 - 30
  expectedStatus   Int                    @default(200) @map("expected_status")
  keyword          String?
  headers          Json?                  @default("{}")
  body             String?
  failureThreshold Int                    @default(2) @map("failure_threshold")
  isActive         Boolean                @default(true) @map("is_active")
  isPublic         Boolean                @default(false) @map("is_public")
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")

  user             User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkResults     CheckResult[]
  incidents        Incident[]
  alertChannels    MonitorAlertChannel[]

  @@map("monitors")
}

model CheckResult {
  id         BigInt   @id @default(autoincrement())
  monitorId  String   @map("monitor_id")
  checkedAt  DateTime @default(now()) @map("checked_at")
  success    Boolean
  statusCode Int?     @map("status_code")
  responseMs Int?     @map("response_ms")
  error      String?

  monitor    Monitor  @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@index([monitorId, checkedAt(sort: Desc)])
  @@map("check_results")
}

model Incident {
  id         String    @id @default(uuid())
  monitorId  String    @map("monitor_id")
  startedAt  DateTime  @default(now()) @map("started_at")
  resolvedAt DateTime? @map("resolved_at")
  reason     String?

  monitor    Monitor   @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@map("incidents")
}

model AlertChannel {
  id         String                  @id @default(uuid())
  userId     String                  @map("user_id")
  type       AlertChannelType
  name       String
  config     Json                    // encrypted credentials (email, telegram bot token & chat id)
  isVerified Boolean                 @default(false) @map("is_verified")
  createdAt  DateTime                @default(now()) @map("created_at")
  updatedAt  DateTime                @updatedAt @map("updated_at")

  user       User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  monitors   MonitorAlertChannel[]

  @@map("alert_channels")
}

model MonitorAlertChannel {
  monitorId String       @map("monitor_id")
  channelId String       @map("channel_id")

  monitor   Monitor      @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  channel   AlertChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@id([monitorId, channelId])
  @@map("monitor_alert_channels")
}
